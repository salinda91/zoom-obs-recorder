{
  "name": "zoom-automation",
  "version": "1.0.0",
  "description": "MeetRecord Pro - Zoom scheduler with OBS recording",
  "main": "dist-electron/electron/main.js",
  "author": "",
  "private": true,
  "scripts": {
    "dev": "concurrently \"vite\" \"tsc -p tsconfig.main.json -w\" \"wait-on dist-electron/electron/main.js && wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:dev": "concurrently \"vite\" \"tsc -p tsconfig.main.json -w\" \"wait-on dist-electron/electron/main.js && wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 ELECTRON_ENABLE_LOGGING=1 ELECTRON_ENABLE_STACK_DUMPING=1 electron . --enable-logging\"",
    "electron:dist": "cross-env NODE_ENV=production ELECTRON_ENABLE_LOGGING=1 ELECTRON_ENABLE_STACK_DUMPING=1 electron dist-electron/electron/main.js --enable-logging",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "start": "npm run electron:dev",
    "build": "vite build && tsc -p tsconfig.main.json && electron-builder",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.0",
    "chokidar": "^3.5.3",
    "electron-log": "^5.1.2",
    "luxon": "^3.5.0",
    "obs-websocket-js": "^5.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/better-sqlite3": "^7.6.9",
    "@types/luxon": "^3.4.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.1.4",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "eslint": "^8.57.0",
    "typescript": "^5.4.2",
    "tsx": "^4.7.1",
    "vite": "^5.2.7",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.example.zoom-automation",
    "productName": "MeetRecord Pro",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.ts"
    ],
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
